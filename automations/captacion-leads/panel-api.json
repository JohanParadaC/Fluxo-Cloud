    {
      "id": "c3000000-0000-4000-8000-000000000008",
      "name": "POST /panel-estado",
      "type": "n8n-nodes-base.webhook",
      "typeVersion": 2,
      "position": [
        -660,
        280
      ],
      "webhookId": "d1f1a2b3-4d5e-4f60-9a71-000000000011",
      "parameters": {
        "httpMethod": "POST",
        "path": "panel-estado",
        "responseMode": "responseNode",
        "options": {
          "allowedOrigins": "*",
          "rawBody": true
        }
      }
    },
    {
      "id": "c3000000-0000-4000-8000-000000000009",
      "name": "Comprobar clave y datos",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -440,
        280
      ],
      "parameters": {
        "jsCode": "// El panel envía el cuerpo como texto plano con un JSON dentro, para que el\n// navegador no lance la comprobación previa de CORS. Aquí se parsea.\nconst CLAVE = 'CAMBIA_ESTA_CLAVE';\n\nconst ESTADOS = ['Nuevo', 'Contactado', 'Propuesta enviada', 'Ganado', 'Perdido'];\n\nconst bruto = $input.first().json.body;\nlet datos = {};\n\nif (typeof bruto === 'string') {\n  try { datos = JSON.parse(bruto); } catch (e) { datos = {}; }\n} else if (bruto && typeof bruto === 'object') {\n  datos = bruto;\n}\n\nconst id = String(datos.id || '').trim();\nconst estado = String(datos.estado || '').trim();\nconst autorizado = String(datos.key || '') === CLAVE;\n\n// Se valida el estado contra la lista: así el panel no puede escribir\n// cualquier cosa en la hoja si alguien manipula la petición.\nconst valido = Boolean(id) && ESTADOS.includes(estado);\n\nreturn [{ json: { autorizado, valido, ID: id, Estado: estado } }];"
      }
    },
