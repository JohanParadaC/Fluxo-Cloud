    {
      "id": "c3000000-0000-4000-8000-000000000002",
      "name": "Comprobar clave (lectura)",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        -440,
        -120
      ],
      "parameters": {
        "jsCode": "// Única barrera real del panel: sin la clave correcta no se devuelve nada.\n// Cámbiala aquí y en la pantalla de entrada del panel.\nconst CLAVE = 'CAMBIA_ESTA_CLAVE';\n\nconst item = $input.first().json;\nconst enviada = String((item.query && item.query.key) || '');\n\nreturn [{\n  json: {\n    autorizado: enviada === CLAVE,\n    // Reservado para cuando haya varios clientes: ?cliente=NombreCliente\n    cliente: String((item.query && item.query.cliente) || ''),\n  },\n}];"
      }
    },
    {
      "id": "c3000000-0000-4000-8000-000000000003",
      "name": "¿Clave correcta?",
      "type": "n8n-nodes-base.if",
      "typeVersion": 2.2,
      "position": [
        -220,
        -120
      ],
      "parameters": {
        "conditions": {
          "options": {
            "caseSensitive": true,
            "leftValue": "",
            "typeValidation": "strict",
            "version": 2
          },
          "conditions": [
            {
              "id": "cond-get",
              "leftValue": "={{ $json.autorizado }}",
              "rightValue": "",
              "operator": {
                "type": "boolean",
                "operation": "true",
                "singleValue": true
              }
            }
          ],
          "combinator": "and"
        },
        "options": {}
      }
    },
    {
      "id": "c3000000-0000-4000-8000-000000000004",
      "name": "Leer hoja",
      "type": "n8n-nodes-base.googleSheets",
      "typeVersion": 4.5,
      "position": [
        20,
        -200
      ],
      "parameters": {
        "operation": "read",
        "documentId": {
          "__rl": true,
          "value": "PEGA_AQUI_EL_ID_DE_TU_HOJA",
          "mode": "id"
        },
        "sheetName": {
          "__rl": true,
          "value": "Leads",
          "mode": "name"
        },
        "options": {}
      }
    },
    {
      "id": "c3000000-0000-4000-8000-000000000005",
      "name": "Mapear leads",
      "type": "n8n-nodes-base.code",
      "typeVersion": 2,
      "position": [
        240,
        -200
      ],
      "parameters": {
        "jsCode": "// Convierte las filas de Google Sheets al formato que espera el panel.\n// Las filas vacías de la hoja se descartan.\n\nconst filtroCliente = $('Comprobar clave (lectura)').first().json.cliente;\nconst texto = (valor) => String(valor === undefined || valor === null ? '' : valor).trim();\n\nconst leads = $input.all()\n  .map((item) => item.json)\n  .filter((fila) => texto(fila.ID))\n  .filter((fila) => !filtroCliente || texto(fila.Cliente) === filtroCliente)\n  .map((fila) => ({\n    id: texto(fila.ID),\n    fecha: texto(fila.Fecha),\n    nombre: texto(fila.Nombre),\n    email: texto(fila.Email),\n    telefono: texto(fila.Telefono),\n    empresa: texto(fila.Empresa),\n    servicio: texto(fila.Servicio),\n    presupuesto: texto(fila.Presupuesto),\n    mensaje: texto(fila.Mensaje),\n    score: Number(fila.Score) || 0,\n    clasificacion: texto(fila.Clasificacion) || 'D',\n    estado: texto(fila.Estado) || 'Nuevo',\n    accion: texto(fila.Accion),\n    responderAntesDe: texto(fila.ResponderAntesDe),\n    motivos: texto(fila.Motivos),\n    origen: texto(fila.Origen),\n    pagina: texto(fila.Pagina),\n    cliente: texto(fila.Cliente),\n  }));\n\n// Un solo item: el panel espera un objeto con la lista dentro.\nreturn [{ json: { ok: true, total: leads.length, leads } }];"
      }
    },
    {
