# Copia este archivo como `.env` y rellena lo que uses.
# Vite solo expone al navegador las variables que empiezan por VITE_.
# Todo lo de aquí es opcional: si se deja vacío, esa función simplemente
# no se activa y la web sigue funcionando.

# ---------------------------------------------------------------------------
# Formulario de contacto
# ---------------------------------------------------------------------------
# URL de producción del webhook de n8n que recibe las solicitudes.
# Se obtiene en el nodo "Formulario web (POST)" del flujo
# `automations/captacion-leads/workflow.json`, pestaña "Production URL".
#
# Si se deja vacío, el formulario abre WhatsApp con el mensaje redactado
# y NO queda registro de la solicitud en ningún sitio.
VITE_FORM_ENDPOINT=

# ---------------------------------------------------------------------------
# Agenda (Cal.com)
# ---------------------------------------------------------------------------
# Enlace público al tipo de evento que quieres que reserven.
# Ejemplo: https://cal.com/fluxocloud/diagnostico
#
# Con esto configurado, "Agendar diagnóstico" abre el calendario en un modal
# y la reunión queda reservada sin intercambiar un solo mensaje.
# Vacío: los botones siguen llevando al formulario, como hasta ahora.
VITE_CAL_LINK=

# ---------------------------------------------------------------------------
# Analítica
# ---------------------------------------------------------------------------
# Proveedor: "umami" o "plausible". Vacío = sin analítica.
# Los dos son sin cookies y no necesitan banner de consentimiento.
#
# Recomendado: Umami autoalojado en tu VPS. Gratis y los datos de los
# visitantes no salen de tu máquina.
VITE_ANALYTICS_PROVIDER=

# URL del script del proveedor.
#   Umami autoalojado -> https://analytics.tudominio.com/script.js
#   Plausible         -> https://plausible.io/js/script.js
VITE_ANALYTICS_SRC=

# Identificador del sitio.
#   Umami     -> el "Website ID" (un UUID) que da el panel
#   Plausible -> el dominio, p. ej. fluxocloudlabs.net
VITE_ANALYTICS_ID=
