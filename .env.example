# Copia este archivo como `.env` y rellena el valor.
# Vite solo expone al navegador las variables que empiezan por VITE_.

# URL de producción del webhook de n8n que recibe el formulario de contacto.
# Se obtiene en el nodo "Formulario web (POST)" del flujo
# `automations/captacion-leads/workflow.json`, pestaña "Production URL".
#
# Si se deja vacío, el formulario abre WhatsApp con el mensaje redactado
# y NO queda registro de la solicitud en ningún sitio.
VITE_FORM_ENDPOINT=
